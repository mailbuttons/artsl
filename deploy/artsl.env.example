# /opt/artsl/artsl.env — read by artsl.service and artsl-publish.service
ANTHROPIC_API_KEY=sk-ant-...
ARTSL_DATA_DIR=/var/lib/artsl
ARTSL_LISTEN=127.0.0.1:8090
# Where subscriber keys are checked (GET /api/v1/mailboxes with the Bearer key).
# The public host works; an internal backend address avoids the nginx hop.
ARTSL_MAILBUTTONS_URL=https://mailbuttons.com
ARTSL_REFRESH_HOURS=6
ARTSL_DAILY_QUOTA=24
ARTSL_CONCURRENCY=2
# Optional: a config.toml with [generate] model/effort/feeds overrides
# ARTSL_CONFIG=/opt/artsl/config.toml
