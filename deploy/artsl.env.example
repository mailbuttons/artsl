# /opt/artsl/artsl.env — read by artsl.service and artsl-publish.service.
# chmod 0640 root:artsl
ANTHROPIC_API_KEY=sk-ant-...
ARTSL_DATA_DIR=/var/lib/artsl
ARTSL_LISTEN=127.0.0.1:8090
# Where account keys are checked at subscribe time (GET /api/v1/mailboxes
# with the Bearer key). The public host works; an internal backend address
# avoids the nginx hop.
ARTSL_MAILBUTTONS_URL=https://mailbuttons.com
ARTSL_REFRESH_HOURS=6
ARTSL_DAILY_QUOTA=24
ARTSL_CONCURRENCY=2
ARTSL_ARCHIVE_DAYS=90
# Set to enable GET /art/v1/admin/stats and POST /art/v1/admin/revoke.
# Generate with: openssl rand -hex 32
# ARTSL_ADMIN_TOKEN=
# Log level (tracing EnvFilter syntax)
RUST_LOG=info,tower_http=info
# Optional: a config.toml with [generate] model/effort/feeds overrides
# ARTSL_CONFIG=/opt/artsl/config.toml
